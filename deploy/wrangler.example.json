{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "natures-mossy-friends",
  "main": "../worker/standalone.ts",
  "compatibility_date": "2026-11-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "d1_databases": [{ "binding": "DB", "database_name": "mossy-friends", "database_id": "00000000-0000-4000-8000-000000000000", "migrations_dir": "../drizzle" }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "mossy-friends-photos" }],
  "vars": { "PRIVACY_CONTACT_EMAIL": "naturesmossyfriends@gmail.com", "FIREBASE_PROJECT_ID": "" },
  "observability": { "enabled": false }
}
